<% disabled = !Current.user.can_administer_board?(board) %>
<header>
  <h2 class="divider txt-medium margin-block-start">Who can access this board?</h2>
</header>

<%# The browser submits with the form's first submit button on Enter: this one, so Enter still saves, as upstream, instead of searching. %>
<button type="submit" hidden tabindex="-1" aria-hidden="true"></button>

<%= access_menu_tag board, class: "settings__user-filter unpad margin-none" do %>
  <li class="flex align-center gap-half">
    <figure class="avatar fill-selected">
      <%= icon_tag "everyone" %>
      <span class="for-screen-reader">Everyone</span>
    </figure>

    <div class="min-width">
      <div class="overflow-ellipsis"><strong>Everyone</strong></div>
    </div>

    <hr class="separator--horizontal flex-item-grow" style="--border-color: var(--color-ink-medium); --border-style: dashed" aria-hidden="true" />

    <label for="board_all_access" class="switch">
      <%= form.check_box :all_access, class: "switch__input", checked: board.all_access?, disabled:, data: { action: "change->toggle-class#toggle" } %>
      <span class="switch__btn round"></span>
      <span class="for-screen-reader">Give everyone access to this board</span>
    </label>
  </li>

  <input placeholder="Filter…" class="input input--transparent full-width txt-small" type="search" autocorrect="off" autocomplete="off" data-1p-ignore="true" data-filter-target="input" data-action="input->filter#filter">

  <div class="toggler__visible-when-off">
    <div class="flex align-center justify-end gap-half">
      <%= button_tag "Select all", type: "button", class: "btn btn--plain txt-x-small txt-link font-weight-normal", data: { action: "click->toggle-class#checkAll" }, disabled: %>
      <span class="txt-subtle">&middot;</span>
      <%= button_tag "Select none", type: "button", class: "btn btn--plain txt-x-small txt-link font-weight-normal", data: { action: "click->toggle-class#checkNone" }, disabled: %>
    </div>
  </div>

  <ul class="settings__scrollable-list" data-filter-target="list">
    <%= access_toggles_for selected_users, selected: true, disabled: %>
    <%= render partial: "fizzy/oidc/boards/group_member_toggle", collection: @group_users, as: :user, locals: { granted_through: @granted_through } %>
  </ul>

  <%# The search button belongs to the board's form, so a search carries the people already ticked. Enter in the field clicks it rather than Save. %>
  <% unless disabled %>
    <div class="toggler__visible-when-off" data-controller="clicker">
      <div class="flex align-center gap-half margin-block-start">
        <%= search_field_tag :q, params[:q], placeholder: "Find someone to add…", class: "input full-width txt-small",
              autocorrect: "off", autocomplete: "off", aria: { label: "Find someone to add by name or email" },
              data: { "1p-ignore": "true", action: "keydown.enter->clicker#click:stop:prevent" } %>
        <%= button_tag "Search", type: "submit", name: "search_people", value: "1", class: "btn txt-small",
              data: { clicker_target: "clickable", turbo_frame: "board_access_search_results" } %>
      </div>

      <%= turbo_frame_tag "board_access_search_results" do %>
        <ul class="settings__scrollable-list margin-block-start">
          <%= access_toggles_for @ticked_users, selected: true %>
          <%= access_toggles_for unselected_users, selected: false %>
        </ul>
        <% if params[:q].present? && unselected_users.none? %>
          <p class="txt-small txt-subtle">No one else matches “<%= params[:q] %>”.</p>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <%# Project groups from the IdP: every member of a ticked group gets access, and loses it when the group is unticked. %>
  <div class="toggler__visible-when-off">
    <h3 class="divider txt-small margin-block-start">Groups</h3>

    <%# Always sent, so unticking the last group still reaches #update. %>
    <input type="hidden" name="group_ids[]" value="">
    <ul class="settings__scrollable-list">
      <%# A group is private to its members: whoever is not in an attached group sees it, locked. Disabled, it is not submitted, and #update keeps it. %>
      <% @board_groups.each do |group| %>
        <%= render "fizzy/oidc/boards/group_toggle", group:, selected: true, disabled: disabled || @locked_group_ids.include?(group.id), locked: @locked_group_ids.include?(group.id) %>
      <% end %>
    </ul>

    <% unless disabled %>
      <div data-controller="clicker">
        <div class="flex align-center gap-half margin-block-start">
          <%= search_field_tag :group_q, params[:group_q], placeholder: "Find a group to add…", class: "input full-width txt-small",
                autocorrect: "off", autocomplete: "off", aria: { label: "Find a group to add by name" },
                data: { "1p-ignore": "true", action: "keydown.enter->clicker#click:stop:prevent" } %>
          <%= button_tag "Search", type: "submit", name: "search_groups", value: "1", class: "btn txt-small",
                data: { clicker_target: "clickable", turbo_frame: "board_group_search_results" } %>
        </div>

        <%= turbo_frame_tag "board_group_search_results" do %>
          <ul class="settings__scrollable-list margin-block-start">
            <%= render partial: "fizzy/oidc/boards/group_toggle", collection: @ticked_groups, as: :group, locals: { selected: true, disabled: false } %>
            <%= render partial: "fizzy/oidc/boards/group_toggle", collection: @unselected_groups, as: :group, locals: { selected: false, disabled: false } %>
          </ul>
          <% if params[:group_q].present? && @unselected_groups.none? %>
            <p class="txt-small txt-subtle">No other group matches “<%= params[:group_q] %>”.</p>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
